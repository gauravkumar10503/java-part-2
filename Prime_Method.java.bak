class  Prime_Method
{
	public static void main(String[] args) 
	{
		System.out.println("Main start from here ");
		prime(67);
	}
	public static void prime(int num)
	{
		int count=0;
		for(int i=1;i<=num;i++)
		{
			if(num%i==0)
			{
				count++;
			}
		}
	
		if(count==2)
		{
			System.out.println("Given number "+num+" is prime ");
		}
		else
		{
			System.out.println("Given number "+num+" is not prime");
		}
	}
}
