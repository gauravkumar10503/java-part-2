import java.util.Scanner;
class  Prime_Withargument_Withoutreturn
{
	public static void main(String[] args) 
	{
		Scanner sc=new Scanner(System.in);
		System.out.println("Enter your number :- ");
		int p=sc.nextInt();
		prime(p);
	}
	public static void prime(int x)
	{
		int count=0;
		for(int j=2;j<=x;j++)
		{
			
			for(int i=1;i<=j;i++)
			{
				if(j%i==0)
				{
					count++;
				}
			}
			if(count==2)
			{
				System.out.print(j+" ");
			}
		}
		System.out.println();
	}
}
